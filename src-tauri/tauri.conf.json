{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SMARTCheck",
  "version": "0.1.0",
  "identifier": "com.smartcheck.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SMARTCheck",
        "width": 1280,
        "height": 780,
        "minWidth": 1100,
        "minHeight": 660,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "publisher": "SMARTCheck",
    "shortDescription": "Drive health checker",
    "resources": {
      "resources/smartmontools/": "smartmontools/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
